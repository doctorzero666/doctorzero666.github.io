---
import { useUI } from '../i18n';
import { pick, profile, type Locale } from '../lib/data';
// Cut-out portrait for the pixel figure; generated by scripts/build-hero-portrait.mjs.
import portrait from '../assets/hero/portrait.webp';

interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = useUI(locale);
const badges = profile.hero_badges.map((b) => pick(b, locale)).filter(Boolean);
---
<section class="hero" aria-labelledby="hero-name">
  <canvas class="field" data-field data-src={portrait.src} aria-hidden="true"></canvas>
  <div class="container inner">
    <div class="intro-line">
      <p class="headline"><span class="brand-sub">{profile.brand_sub}</span></p>
    </div>
    <h1 class="name" id="hero-name">
      <span class="sr-only">{pick(profile.name, locale)}</span>
      <span class="first" aria-hidden="true">{profile.display.first}</span>
      <span class="last" aria-hidden="true">{profile.display.last}</span>
    </h1>
    {pick(profile.tagline, locale) && <p class="tagline small">{pick(profile.tagline, locale)}</p>}
    <div class="foot">
      <ul class="badges small">
        {badges.map((b) => <li>{b}</li>)}
      </ul>
      <a class="scroll small" href="#work"><span class="scroll-label">{ui.labels.scroll_down} <span class="arrow" aria-hidden="true">↓</span></span></a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100svh - var(--header-h));
    background-color: var(--hero-ground);
    display: flex;
    overflow: hidden;
  }
  :global(:root[data-theme='dark']) .hero { color: #ECE9E4; }
  /* The canvas is transparent: the pixel figure sits straight on the hero ground. */
  .field { position: absolute; inset: 0; width: 100%; height: 100%; }
  .inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: calc(var(--u) * 4) calc(var(--u) * 3);
    gap: calc(var(--u) * 6);
  }
  .headline { font-size: 0.95rem; font-weight: 500; letter-spacing: 0.08em; }
  :global(:root[lang^="zh"]) .headline { letter-spacing: 0.04em; }
  .headline .brand-sub { text-transform: uppercase; }
  .tagline { margin-top: calc(var(--u) * 2); opacity: var(--muted); }
  .name {
    font-family: var(--font-hero);
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    line-height: 0.86;
    letter-spacing: -0.02em;
    margin-top: auto;
  }
  .first, .last { display: block; white-space: nowrap; }
  .first {
    font-weight: 300;
    font-size: clamp(2.3rem, 0.5rem + 10.3vw, 10.3rem);
  }
  .last {
    font-weight: 900;
    color: var(--accent);
    font-size: clamp(3.5rem, 0.8rem + 14.8vw, 14.8rem);
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: calc(var(--u) * 2);
  }
  .badges { display: flex; flex-wrap: wrap; gap: var(--u) calc(var(--u) * 3); }
  .badges li { display: inline-flex; align-items: center; gap: var(--u); }
  .badges li::before { content: ''; width: 7px; height: 7px; background: currentColor; flex: none; }
  /* The label sits on a patch of hero ground so the pixel figure behind it never muddies it.
     The patch's padding is cancelled by an equal negative margin: the label does not move.
     Only the label fades, so the patch stays solid. */
  .scroll { white-space: nowrap; background: var(--hero-ground); padding: 2px 8px; margin: -2px -8px; }
  .scroll-label { opacity: var(--muted); transition: opacity 0.3s ease; }
  .scroll:hover .scroll-label { opacity: 1; }
  .arrow { display: inline-block; }
  /* One-off rise for the name and a slow nudge on the scroll arrow. Transform only:
     the name is fully visible in its default state, with or without JS, animation
     support or motion; the animation never hides it. Off for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .first, .last { animation: rise 0.7s var(--reveal-curve); }
    .last { animation-duration: 0.85s; }
    .arrow { animation: nudge 1.6s ease-in-out 1.2s infinite alternate; }
  }
  @keyframes rise {
    from { transform: translateY(0.18em); }
    to { transform: none; }
  }
  @keyframes nudge {
    from { transform: translateY(-1px); }
    to { transform: translateY(3px); }
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }
  @media (max-width: 480px) {
    .inner { gap: calc(var(--u) * 4); padding-block: calc(var(--u) * 3); }
    .first { font-size: clamp(2rem, 13vw, 3.4rem); }
    .last { font-size: clamp(2.6rem, 17vw, 4.4rem); }
    .foot { flex-direction: column; align-items: flex-start; }
    .badges { flex-direction: column; gap: var(--u); }
  }
</style>

<script>
  // Pixel portrait (src/lib/hero-pixel.ts) with the tuned values in src/data/hero-pixel.json.
  // Placement switches at the site's 900px breakpoint (global.css).
  import params from '../data/hero-pixel.json';
  import { mountHeroPixel } from '../lib/hero-pixel';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-field]');
  const host = canvas?.parentElement;
  if (canvas && host && canvas.dataset.src) mountHeroPixel(canvas, host, canvas.dataset.src, params, '(max-width: 900px)');
</script>
