---
// Home-page index: name / category / years per row. Hover or focus reveals the one-line
// summary and a single primary link; the whole row links to the full entry on /portfolio/.
import { localePath, useUI } from '../i18n';
import { pick, primaryLink, type Locale, type Project } from '../lib/data';
import { projectEntryAttrs, projectLinkAttrs } from '../lib/analytics-links';

interface Props { projects: Project[]; locale: Locale }
const { projects, locale } = Astro.props;
const ui = useUI(locale);
const portfolio = localePath(locale, 'portfolio');
const external = (url: string) => /^https?:\/\//.test(url);
---
<div class="ptable" role="list">
  <div class="phead micro muted" aria-hidden="true">
    <span>{ui.table.name}</span><span>{ui.table.category}</span><span>{ui.table.years}</span>
  </div>
  {projects.map((p) => {
    const link = primaryLink(p);
    return (
      <article class="prow" role="listitem" aria-labelledby={`p-${p.slug}`}>
        <div class="pline">
          <h3 class="pname" id={`p-${p.slug}`}>
            <a class="prow-link" href={`${portfolio}#${p.slug}`} title={ui.index.full_entry} {...projectEntryAttrs(p, 'index_row')}>{p.name}</a>
          </h3>
          <p class="pcat muted">{pick(p.category, locale)}</p>
          <p class="pyear muted">[{p.years}]</p>
        </div>
        <div class="pmore">
          <div class="pmore-inner">
            <p class="psum">{pick(p.summary, locale)}</p>
            {link && (
              <p class="plink small">
                <a class="link bracket" href={link.url} target={external(link.url) ? '_blank' : undefined} rel={external(link.url) ? 'noopener' : undefined} {...projectLinkAttrs(p, link)}>
                  {pick(link.label, locale)} ↗
                </a>
              </p>
            )}
          </div>
        </div>
      </article>
    );
  })}
</div>

<style>
  .ptable { border-top: var(--line); }
  .phead, .pline {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.6fr) auto;
    gap: calc(var(--u) * 2);
    align-items: baseline;
  }
  .phead { padding-block: var(--u); border-bottom: var(--line); }
  .prow { position: relative; border-bottom: var(--line); cursor: pointer; }
  /* The name link stretches over the whole row, so any click on the row opens the full entry. */
  .prow-link { color: inherit; text-decoration: none; }
  .prow-link::after { content: ''; position: absolute; inset: 0; outline-offset: -1px; }
  .prow-link:focus { outline: none; }
  .prow-link:focus-visible::after { outline: 1px solid var(--ink); }
  /* The primary link sits above the stretched row link so it stays clickable on its own. */
  .plink { position: relative; z-index: 1; }
  /* Ruler tick on the active row: a 1px spine with 8px ticks, just left of the table. Fades only. */
  .prow::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: -1px;
    left: calc(var(--u) * -2);
    width: 6px;
    border-left: var(--line);
    background: repeating-linear-gradient(to bottom, var(--ink) 0 1px, transparent 1px 8px) left / 6px 100% no-repeat;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .prow:hover::before, .prow:focus-within::before { opacity: 0.5; }
  .pline { padding-block: calc(var(--u) * 2); transition: padding 0.35s ease; }
  .pname { font-size: 0.9rem; font-weight: 600; }
  .pcat, .pyear { font-size: 0.85rem; }
  .pyear { white-space: nowrap; font-variant-numeric: tabular-nums; }
  /* Collapsed by default; expands on hover or keyboard focus. */
  .pmore {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }
  .pmore-inner { overflow: hidden; min-height: 0; }
  .prow:hover .pmore, .prow:focus-within .pmore { grid-template-rows: 1fr; }
  .prow:hover .pline, .prow:focus-within .pline { padding-block: calc(var(--u) * 3) var(--u); }
  .pmore-inner > * + * { margin-top: var(--u); }
  .pmore-inner > :last-child { margin-bottom: calc(var(--u) * 3); }
  .psum { font-size: 0.85rem; line-height: 1.6; max-width: 36em; }
  .psum, .pcat { overflow-wrap: anywhere; }
  @media (prefers-reduced-motion: reduce) {
    .prow::before, .pline, .pmore { transition: none; }
  }
  /* Touch screens have no hover: the summary is always shown and the row is a plain tap target. */
  @media (hover: none) {
    .pmore { grid-template-rows: 1fr; }
    .prow::before { display: none; }
    .prow:focus-within .pline { padding-block: calc(var(--u) * 2); }
  }
  @media (max-width: 480px) {
    .phead { display: none; }
    .pline { grid-template-columns: 1fr auto; row-gap: 2px; }
    .pname { grid-column: 1; }
    .pyear { grid-column: 2; grid-row: 1; }
    .pcat { grid-column: 1 / -1; }
    .pmore { grid-template-rows: 1fr; }
    .prow::before { display: none; }
  }
</style>
