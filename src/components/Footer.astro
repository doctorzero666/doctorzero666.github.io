---
import { useUI } from '../i18n';
import { pick, profile, type Locale } from '../lib/data';
import { gaAttrs, profileLinkAttrs } from '../lib/analytics-links';

interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = useUI(locale);
// Three identity layers: brand (never translated), real name, technical handle.
const brand = pick(profile.brand, locale);
const realName = `${profile.display.first} ${profile.display.last}`.replace(/\.$/, '').toUpperCase();
const links = profile.links.filter((l) => l.url && l.url.trim());
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="rule-bleed"></div>
  <div class="container grid-12 top">
    <div class="ident reveal">
      {brand && <p class="f-brand" lang="zh-CN">{brand}</p>}
      <p class="f-name">{realName}{profile.handle && ` / ${profile.handle}`}</p>
      <p class="f-connect micro muted">{ui.footer.connect}</p>
      <p class="f-invite small">{ui.footer.invite}</p>
      <ul class="f-links micro">
        <li><a class="bracket" href={`mailto:${profile.email}`} {...gaAttrs('contact_click', { contact_type: 'email' })}>EMAIL</a></li>
        {links.map((l) => <li><a class="bracket" href={l.url} rel="me noopener" target="_blank" {...profileLinkAttrs(l.id)}>{l.label.toUpperCase()}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="container bottom small">
    <p class="muted">© {year} {pick(profile.copyright_name, locale)}. {ui.footer.rights}</p>
  </div>
  <div class="ruler" aria-hidden="true"></div>
</footer>

<style>
  .site-footer { padding-bottom: calc(var(--u) * 3); }
  .top {
    padding-top: calc(var(--u) * 8);
    padding-bottom: calc(var(--u) * 6);
    row-gap: calc(var(--u) * 4);
    align-items: end;
  }
  .ident { grid-column: 1 / span 5; display: flex; flex-direction: column; gap: calc(var(--u) * 0.5); }
  .f-brand {
    font-family: var(--font-cjk);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }
  .f-name {
    font-family: var(--font-plate);
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    line-height: 1.1;
    letter-spacing: 0.05em;
  }
  .f-connect { margin-top: calc(var(--u) * 3); }
  .f-invite { overflow-wrap: anywhere; }
  .f-links { display: flex; flex-wrap: wrap; gap: calc(var(--u) * 3); margin-top: var(--u); letter-spacing: 0.08em; }
  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: calc(var(--u) * 2);
    flex-wrap: wrap;
    padding-block: calc(var(--u) * 2);
    border-top: var(--line);
  }
  .ruler {
    height: 12px;
    margin-top: calc(var(--u) * 2);
    border-top: var(--line);
    background:
      repeating-linear-gradient(to right, var(--ink) 0 1px, transparent 1px 40px) top / 100% 12px no-repeat,
      repeating-linear-gradient(to right, var(--ink) 0 1px, transparent 1px 8px) top / 100% 5px no-repeat;
    opacity: 0.5;
  }
  @media (max-width: 768px) {
    .ident { grid-column: 1 / -1; }
  }
</style>
