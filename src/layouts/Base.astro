---
import '@fontsource/instrument-serif/latin-400.css';
import '../styles/fonts.css';
import '@fontsource/koulen/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { htmlLang, localePath, pageFromPath, useUI } from '../i18n';
import { pick, profile, type Locale } from '../lib/data';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const ui = useUI(locale);
const siteName = pick(profile.name, locale);
const fullTitle = title ? `${title} · ${siteName}` : `${siteName} · ${pick(profile.headline, locale)}`;
const desc = description || pick(profile.headline, locale) || ui.meta.description;
const page = pageFromPath(Astro.url.pathname);
const canonical = new URL(localePath(locale, page), Astro.site);
const altZh = new URL(localePath('zh', page), Astro.site);
const altEn = new URL(localePath('en', page), Astro.site);
---
<!doctype html>
<html lang={htmlLang[locale]} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Theme: runs before first paint. Stored choice wins; otherwise the system preference sets the initial value. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.setAttribute('data-theme', t);
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="zh-CN" href={altZh.href} />
    <link rel="alternate" hreflang="en" href={altEn.href} />
    <link rel="alternate" hreflang="x-default" href={altZh.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="theme-color" content="#F3EEE4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      // Fade-and-rise reveal. Skipped entirely when the user prefers reduced motion.
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
