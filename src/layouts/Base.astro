---
import '@fontsource/instrument-serif/latin-400.css';
import '../styles/fonts.css';
import '@fontsource/koulen/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { htmlLang, localePath, pageFromPath, useUI } from '../i18n';
import { firstSentence, pick, profile, type Locale } from '../lib/data';
import { PUBLIC_GA_MEASUREMENT_ID } from 'astro:env/client';

interface Props {
  locale: Locale;
  /** Short page name; rendered as "<title> · <site name>". */
  title?: string;
  /** Complete <title>, used as is (the home page passes seo.home_title). */
  fullTitle?: string;
  description?: string;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}

const { locale, title, fullTitle: fullTitleProp, description, noindex = false } = Astro.props;
const ui = useUI(locale);
const siteName = pick(profile.name, locale);
const fullTitle = fullTitleProp || (title ? `${title} · ${siteName}` : pick(profile.seo.home_title, locale) || siteName);
// Pages pass their own description; the tagline is deliberately not in this chain so it
// cannot leak into sub-page metadata.
const desc = description || firstSentence(pick(profile.intro, locale)) || ui.meta.description;
const page = pageFromPath(Astro.url.pathname);
const canonical = new URL(localePath(locale, page), Astro.site);
const altZh = new URL(localePath('zh', page), Astro.site);
const altEn = new URL(localePath('en', page), Astro.site);
const siteRoot = new URL('/', Astro.site).href;
const brand = pick(profile.brand, locale);
const shareImage = profile.seo.share_image ? new URL(profile.seo.share_image, Astro.site).href : '';
// Structured identity, home pages only (zh and en); sub-pages do not repeat it.
const person = profile.seo.person;
const personLd = page === '' && person
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name.en,
      alternateName: profile.brand.zh,
      url: siteRoot,
      sameAs: profile.links.map((l) => l.url).filter(Boolean),
      alumniOf: person.alumni.map((n) => ({ '@type': 'CollegeOrUniversity', name: n })),
      knowsAbout: person.knows_about.slice(0, 5),
    })
  : '';
// GA4: emitted only in production builds with a well-formed ID; dev builds get nothing.
const gaId = import.meta.env.PROD && PUBLIC_GA_MEASUREMENT_ID && /^G-[A-Z0-9]+$/.test(PUBLIC_GA_MEASUREMENT_ID)
  ? PUBLIC_GA_MEASUREMENT_ID
  : '';
---
<!doctype html>
<html lang={htmlLang[locale]} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Theme: runs before first paint. Stored choice wins; otherwise the system preference sets the initial value. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.setAttribute('data-theme', t);
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && (
      <>
        <link rel="canonical" href={canonical.href} />
        <link rel="alternate" hreflang="zh-CN" href={altZh.href} />
        <link rel="alternate" hreflang="en" href={altEn.href} />
        <link rel="alternate" hreflang="x-default" href={altZh.href} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:site_name" content={brand} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    {personLd && <script type="application/ld+json" set:html={personLd} />}
    <meta name="theme-color" content="#F3EEE4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    {gaId && (
      <>
        <!-- GA4. Guard 1 (build time): only in production builds with PUBLIC_GA_MEASUREMENT_ID set.
             Guard 2 (runtime): skip on localhost / 127.0.0.1 / ::1 so `astro preview` sends no hits. -->
        <script is:inline define:vars={{ gaId }}>
          (function () {
            var h = location.hostname;
            if (h === 'localhost' || h === '127.0.0.1' || h === '[::1]' || h === '::1') return;
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
            document.head.appendChild(s);
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            window.gtag('config', gaId);
          })();
        </script>
      </>
    )}
  </head>
  <body>
    <Header locale={locale} switchHome={noindex} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import { initAnalytics } from '../lib/analytics';
      // Fade-and-rise reveal. Skipped entirely when the user prefers reduced motion.
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      }
      // Click events (data-ga-* attributes); a no-op in dev and when GA is not loaded.
      initAnalytics();
    </script>
  </body>
</html>
