---
import '@fontsource/instrument-serif/latin-400.css';
import '../styles/fonts.css';
import '@fontsource/koulen/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { htmlLang, localePath, pageFromPath, useUI } from '../i18n';
import { firstSentence, lang, pick, profile, type Locale } from '../lib/data';
import { PUBLIC_GA_MEASUREMENT_ID } from 'astro:env/client';

interface Props {
  locale: Locale;
  /** Short page name; rendered as "<title> · <site name>". */
  title?: string;
  /** Complete <title>, used as is (the home page passes seo.home_title). */
  fullTitle?: string;
  description?: string;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}

const { locale, title, fullTitle: fullTitleProp, description, noindex = false } = Astro.props;
const ui = useUI(locale);
const siteName = pick(profile.name, locale);
const fullTitle = fullTitleProp || (title ? `${title} · ${siteName}` : pick(profile.seo.home_title, locale) || siteName);
// Pages pass their own description; the tagline is deliberately not in this chain so it
// cannot leak into sub-page metadata.
const desc = description || firstSentence(pick(profile.intro, locale)) || ui.meta.description;
const page = pageFromPath(Astro.url.pathname);
const isPost = page.startsWith('blog/');
const canonical = new URL(localePath(locale, page), Astro.site);
const altZh = new URL(localePath('zh', page), Astro.site);
const altEn = new URL(localePath('en', page), Astro.site);
const siteRoot = new URL('/', Astro.site).href;
const brand = pick(profile.brand, locale);
// Auto language routing (see README). Off on the 404 page (no locale twin) and on blog
// posts (single-language); parameters live in src/data/lang.yaml.
const langDetect = !noindex && !isPost;
const langCfg = { zhRegions: lang.zh_regions, deadlineMs: lang.deadline_ms, providers: lang.providers };
const shareImage = profile.seo.share_image ? new URL(profile.seo.share_image, Astro.site).href : '';
// Structured identity, home pages only (zh and en); sub-pages do not repeat it.
const person = profile.seo.person;
const personLd = page === '' && person
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name.en,
      alternateName: profile.brand.zh,
      url: siteRoot,
      sameAs: profile.links.map((l) => l.url).filter(Boolean),
      alumniOf: person.alumni.map((n) => ({ '@type': 'CollegeOrUniversity', name: n })),
      knowsAbout: person.knows_about.slice(0, 5),
    })
  : '';
// GA4: emitted only in production builds with a well-formed ID; dev builds get nothing.
const gaId = import.meta.env.PROD && PUBLIC_GA_MEASUREMENT_ID && /^G-[A-Z0-9]+$/.test(PUBLIC_GA_MEASUREMENT_ID)
  ? PUBLIC_GA_MEASUREMENT_ID
  : '';
---
<!doctype html>
<html lang={htmlLang[locale]} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Theme: runs before first paint. Stored choice wins; otherwise the system preference sets the initial value. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.setAttribute('data-theme', t);
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && (
      <>
        <link rel="canonical" href={canonical.href} />
        {!isPost && <>
          <link rel="alternate" hreflang="zh-CN" href={altZh.href} />
          <link rel="alternate" hreflang="en" href={altEn.href} />
          <link rel="alternate" hreflang="x-default" href={altZh.href} />
        </>}
      </>
    )}
    <meta property="og:type" content={isPost ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:site_name" content={brand} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    {personLd && <script type="application/ld+json" set:html={personLd} />}
    <meta name="theme-color" content="#F3EEE4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/feed+json" title="Blog" href="/feed.json" />
    <meta name="generator" content={Astro.generator} />
    {gaId && (
      <>
        <!-- GA4. Guard 1 (build time): only in production builds with PUBLIC_GA_MEASUREMENT_ID set.
             Guard 2 (runtime): skip on localhost / 127.0.0.1 / ::1 so `astro preview` sends no hits. -->
        <script is:inline define:vars={{ gaId }}>
          (function () {
            var h = location.hostname;
            if (h === 'localhost' || h === '127.0.0.1' || h === '[::1]' || h === '::1') return;
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
            document.head.appendChild(s);
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            window.gtag('config', gaId);
          })();
        </script>
      </>
    )}
    {langDetect && (
      <>
        <!-- Auto language routing (see README). Runs before first paint: a saved choice is
             applied straight away; on a first visit the page stays hidden until the country
             lookup answers or langCfg.deadlineMs passes. Path helpers mirror src/i18n — keep
             in sync. Stored keys: lang (the choice, localStorage; also written by the header
             switcher), lang-hop (one automatic jump per tab), lang-route (the decision, read
             by reportLangRoute() in src/lib/analytics.ts on the landing page). -->
        <script is:inline define:vars={{ langCfg }}>
          (function () {
            var root = document.documentElement;
            var local = window.localStorage;
            var sess = window.sessionStorage;
            var CHOICE = 'lang';

            function read(area, key) { try { return area.getItem(key); } catch (e) { return null; } }
            function write(area, key, value) { try { area.setItem(key, value); } catch (e) {} }

            // Locale and page part of the current URL; mirrors localeFromPath / pageFromPath.
            var here = /^\/en(\/|$)/.test(location.pathname) ? 'en' : 'zh';
            var page = location.pathname.replace(/^\/en(?=\/|$)/, '').replace(/^\/+|\/+$/g, '');

            function twin(locale) {
              var prefix = locale === 'en' ? '/en' : '';
              return (page ? prefix + '/' + page : prefix) + '/' + location.search + location.hash;
            }

            function rememberRoute(to, source, canJump) {
              write(sess, 'lang-route', JSON.stringify({ from: here, to: to, source: source, redirected: canJump ? 1 : 0, ts: Date.now() }));
              // analytics.ts may already be listening (decision after it loaded) or may read
              // the record on load (decision before, or a redirect landing). Exactly one wins.
              try { window.dispatchEvent(new Event('lang-route')); } catch (e) {}
            }

            var shown = false;
            function reveal() {
              if (shown) return;
              shown = true;
              root.removeAttribute('data-lang-pending');
            }

            // At most one automatic jump per tab, so a visitor is never bounced twice.
            function hop(to, source) {
              var canJump = !read(sess, 'lang-hop');
              rememberRoute(to, source, canJump);
              if (!canJump) { reveal(); return; }
              write(sess, 'lang-hop', '1');
              location.replace(twin(to));
            }

            function browserLocale() {
              var first = (navigator.languages && navigator.languages[0]) || navigator.language || '';
              return /^zh\b/i.test(first) ? 'zh' : 'en';
            }

            var settled = false;
            function decide(to, source) {
              if (settled) return;
              settled = true;
              if (to !== 'zh' && to !== 'en') to = browserLocale();
              // The decision is remembered, so the next page load needs no lookup at all.
              // Clicking the header switcher overwrites it and wins from then on.
              write(local, CHOICE, to);
              if (to === here) { rememberRoute(to, source, false); reveal(); return; }
              hop(to, source);
            }

            // A bfcache restore can only be a complete page: show it.
            window.addEventListener('pageshow', function (e) { if (e.persisted) reveal(); });

            // Crawlers and link unfurlers never get redirected, hidden or reported.
            if (/bot|crawl|spider|slurp|facebookexternalhit|whatsapp|telegram|discord|linkedin|embedly|pinterest|applebot|petal|yandex|baidu|sogou|bytespider|semrush|ahrefs|mj12|dotbot/i.test(navigator.userAgent)) return;
            // No fetch or no AbortController (very old browser): behave like a crawler.
            if (!window.fetch || !window.AbortController) return;

            // A saved choice wins, now and on every later visit.
            var choice = read(local, CHOICE);
            if (choice === 'zh' || choice === 'en') {
              if (choice !== here) hop(choice, 'stored');
              return; // matches: nothing to do — no lookup, no hiding
            }

            // Do Not Track: skip the third-party lookup, decide from the browser language.
            if (navigator.doNotTrack === '1' || navigator.doNotTrack === 'yes') { decide(null, 'fallback'); return; }

            // First visit: hold the paint (html[data-lang-pending] in global.css) and ask the
            // providers in order. The deadline always fires a decision, so nothing stays hidden.
            root.setAttribute('data-lang-pending', '');
            var t0 = Date.now();
            setTimeout(function () { decide(null, 'fallback'); }, langCfg.deadlineMs);
            ask(0);

            function ask(i) {
              if (settled) return;
              var left = langCfg.deadlineMs - (Date.now() - t0);
              if (i >= langCfg.providers.length || left < 250) { decide(null, 'fallback'); return; }
              var provider = langCfg.providers[i];
              var ctrl = new AbortController();
              var timer = setTimeout(function () { ctrl.abort(); }, Math.min(800, left - 150));
              fetch(provider.url, { signal: ctrl.signal, cache: 'no-store' })
                .then(function (res) {
                  if (!res.ok) throw new Error(String(res.status));
                  return res.text();
                })
                .then(function (body) {
                  clearTimeout(timer);
                  if (settled) return;
                  var code = provider.format === 'text'
                    ? (/^loc=(.+)$/m.exec(body) || [])[1]
                    : (JSON.parse(body).country_code || '');
                  code = String(code || '').trim().toUpperCase();
                  if (!code) throw new Error('no country');
                  decide(langCfg.zhRegions.indexOf(code) > -1 ? 'zh' : 'en', 'ip');
                })
                .catch(function () { clearTimeout(timer); ask(i + 1); });
            }
          })();
        </script>
      </>
    )}
  </head>
  <body>
    <Header locale={locale} switchHome={noindex} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import { initAnalytics, reportLangRoute } from '../lib/analytics';
      // Fade-and-rise reveal. Skipped entirely when the user prefers reduced motion.
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      }
      // Click events (data-ga-* attributes); a no-op in dev and when GA is not loaded.
      initAnalytics();
      // Hand over the routing decision made before first paint (see the inline script above).
      reportLangRoute();
    </script>
  </body>
</html>
