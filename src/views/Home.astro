---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectTable from '../components/ProjectTable.astro';
import MoreWorks from '../components/MoreWorks.astro';
import { useUI } from '../i18n';
import { featuredProjects, moreProjects, pick, profile, type Locale } from '../lib/data';

interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = useUI(locale);
// "[phrase]" in the intro is rendered as a bracketed, bold highlight.
const introParts = pick(profile.intro, locale).split(/(\[[^\]]+\])/g).filter(Boolean);
---
<Base locale={locale}>
  <Hero locale={locale} />
  <section id="work" class="container grid-12 work">
    <div class="intro reveal">
      <p class="micro muted">{ui.sections.featured_intro}</p>
      <p class="intro-text">
        {introParts.map((part) => part.startsWith('[') ? <span class="hl">{part}</span> : part)}
      </p>
      <p class="hint micro muted">{ui.labels.hover_hint}</p>
    </div>
    <div class="table reveal">
      <ProjectTable projects={featuredProjects} locale={locale} />
    </div>
  </section>
  <MoreWorks projects={moreProjects} locale={locale} />
</Base>

<style>
  .work {
    padding-block: calc(var(--u) * 6) calc(var(--u) * 12);
    row-gap: calc(var(--u) * 4);
    scroll-margin-top: calc(var(--header-h) + var(--u) * 2);
  }
  .intro { grid-column: 1 / span 5; align-self: start; position: sticky; top: calc(var(--u) * 10); }
  .table { grid-column: 6 / -1; min-width: 0; }
  /* Small sans, faded ink; the [bracketed] phrase stays at full ink and bold. */
  .intro-text {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.6;
    letter-spacing: -0.005em;
    color: color-mix(in srgb, var(--ink) 60%, transparent);
    margin-top: calc(var(--u) * 1.5);
    max-width: 34em;
  }
  .intro-text .hl { color: var(--ink); font-weight: 600; }
  .hint { margin-top: calc(var(--u) * 3); }
  @media (max-width: 900px) {
    .intro, .table { grid-column: 1 / -1; }
    .intro { position: static; }
  }
  @media (hover: none) { .hint { display: none; } }
</style>
