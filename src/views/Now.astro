---
import Base from '../layouts/Base.astro';
import { useUI } from '../i18n';
import { brandTitle, now, type Locale } from '../lib/data';

interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = useUI(locale);
// Same single-column layout and 1px section rules as the resume page. Both locales read
// the same now.yaml; the section labels are English in both.
const sections = [
  { label: ui.now.building, items: now.building },
  { label: ui.now.exploring, items: now.exploring },
  { label: ui.now.thinking, items: now.thinking },
].filter((s) => s.items && s.items.length > 0);
---
<Base locale={locale} fullTitle={brandTitle(ui.page_titles.now, locale)} description={now.subtitle}>
  <div class="container">
    <header class="page-head">
      <h1 class="display reveal">{ui.now.title}</h1>
    </header>
  </div>
  <div class="rule-bleed"></div>
  <div class="container">
    <div class="article now">
      <p class="sub small muted">{now.subtitle}</p>
      {sections.map((s) => (
        <section class="block reveal">
          <h2 class="micro muted">{s.label}</h2>
          <ul class="items">
            {s.items.map((item) => <li class="lead">{item}</li>)}
          </ul>
        </section>
      ))}
      <p class="updated micro muted">{ui.now.last_updated} / {now.last_updated}</p>
    </div>
  </div>
</Base>

<style>
  .now { padding-bottom: calc(var(--u) * 12); }
  .now > .sub { padding-block: calc(var(--u) * 2) calc(var(--u) * 2); font-variant-numeric: tabular-nums; }
  .block { padding-block: calc(var(--u) * 4); border-bottom: var(--line); }
  .block > h2 { margin-bottom: calc(var(--u) * 2); font-weight: 400; }
  .items { display: grid; gap: var(--u); }
  .lead { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.3; }
  .updated { padding-top: calc(var(--u) * 4); font-variant-numeric: tabular-nums; }
</style>
